# Reserved for future auth work. Accounts are disabled in this release;
# setting these values will not enable them. No environment file is required.
# Use a publishable key, never a secret or service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Future auth callback origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
